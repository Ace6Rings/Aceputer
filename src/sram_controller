`default_nettype none

module sram_controller (
    input   wire      clk,
    input   wire      rst_n,

    input   wire       req,      //1 if cpu requested to do something. switch state to the appropriate thing
    input   wire[7:0]  req_addr, //address
    input   wire[15:0] req_wdata,//write data. 
    input   wire[1:0]  req_type, //least significant bit is read or write, 0 = read, write = 1. most significant bit is req legntth, 0 = 8 bits, 1 = 16 bits


    output  wire       req_rdy, //see if sram_out is valid. 1 for true, 0 for false. if 1, cpu will take that value. if it is a write, then 1 = write successful, 0 = failed
    output  wire[15:0] sram_out //change this name later, confusing with dout
    
);
//MEMORY CONTROL HAVE NO SAFEGUARDS, ITS ALL UP TO THE PROGRAMMER
//THIS IS BASED ON LINE 57-96 IN project.v in the MAIN branch
gf180mcu_ocd_ip_sram__sram256x8m8wm1 sram_inst (
  .CLK  (clk),  // clock
  .A    (sram_addr),  // address
  .D    (sram_din),  // put data from register a into sram
  .Q    (sram_dout),
  .CEN  (!(sram_str || sram_read)),  // sram en, active low
  .GWEN (!(sram_str)),  // sram write en, active low
  .WEN  (8'b00000000)  // might change this, allows rewriting of all bits
);

localparam [1:0] READ_WORD  = 2'b01,
                 WRITE_WORD = 2'b11,
                 READ_BYTE  = 2'00, //name is confusing, change later. but it just means it is reading sram for only one cell and is meant to be put in reg_file. basically opcode is load
                 WRITE_BYTE = 2'10; //basically used for when opcode is store


//states
localparam [1:0] READ_WAIT    = 2'b00,
                 READ_CAPTURE = 2'b01,
                 WRITE        = 2'b10,
                 IDLE         = 2'b11;
// MISC
reg [1:0] state, next_state;
//basic functions ig
wire [7:0] sram_addr;
wire sram_str;
wire sram_read;
wire sram_din; //for writing

//READ INSTRUCTIONS

reg [15:0] instruction_output; //ONLY USED IF REQ_TYPE IS 1

// for if req_type[1] is 1. otherwise just output directly

reg byte_sel; // 1 = high byte, 0 = low byte
initial byte_sel = 0;

reg [7:0] low_byte;
reg [7:0] high_byte;

// for if req_type[1] is 0
wire [7:0] sram_dout;  

// WRITE INSTRUCTIONS




always @(*) begin
    if (req == 1'b1) begin
       case (req_type)
           READ_WORD: begin
                next_state = READ_WAIT;
                sram_read = 1'b1;
            end
           WRITE_WORD: begin
                next_state = WRITE;
            
           end
           READ_BYTE: begin
                sram_read = 1'b1
                sram_addr = req_addr; //can be done combinationally since req_addr doesn't change
                next_state = READ_WAIT;
            end
            WRITE_BYTE: begin
                sram_str = 1'b1
                sram_addr = req_addr; // same here
                sram_din = req_wdata[7:0]; 
                next_state = WRITE;
           end
       endcase
       else begin
        next_state = IDLE;
       end
      if (req_rdy == 1) begin
          sram_out = instruction_output;
          req_rdy = 0;
          next_state <= IDLE;
       end
    end
end

always @(posedge clk) begin
    if (!rst_n) begin
        byte_sel <= 1'b0;
        if ()

    end
    else begin
        state <= next_state;
        case (state)
            READ_WAIT: begin
                state <= READ_CAPTURE:
            end
            READ_CAPTURE: begin
                case (req_type)
                    READ_BYTE: begin //since it is just one byte, just go do it directly.
                        sram_out <= sram_dout; //get the data from sram and put it to the output
                        req_rdy <= 1;
                    end
                    READ_WORD: begin
                        case (byte_sel)
                            1'b0:begin
                                  sram_dout <= instruction_output[7:0]
                                  byte_sel <= 1'b1;
                                  sram_addr <= sram_addr + 8'd1; //increment by 1 to write a word. least significant bit, 0 = low byte, 1 = high byte
                            end
                            1'b1: begin
                                  sram_dout <= instruction_output[15:8]
                                  byte_sel <= 1'b0
                                  req_rdy <= 1;
                            end
                        endcase  
                    end
            end
            WRITE: begin
                case (req_type)
                    WRITE_BYTE: begin
                        sram_out <= 8'b01110010
                    end
                    WRITE_WORD: begin
                        case (byte_sel)
                            1'b0: begin
                                byte_sel  <= 1'b1;
                                sram_addr <= req_addr;
                                sram_din  <= req_wdata[7:0];
                            end 
                            1'b1: begin
                                byte_sel  <= 1'b0;
                                sram_addr <= req_addr + 8'd1;
                                sram_din  <= req_wdata[15:8];
                            end
                    end
            end
            IDLE: begin
                //does nothing. switching states is done combinationally
            end

    end
end




    





