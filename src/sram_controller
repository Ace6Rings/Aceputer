`default_nettype none

module sram_controller (
    input   wire      clk,
    input   wire      rst_n,

    input   wire       req_valid,      //1 if cpu requested to do something. switch state to the appropriate thing
    input   wire[7:0]  req_addr, //address
    input   wire[15:0] req_wdata,//write data. 
    input   wire[1:0]  req_type, //least significant bit is read or write, 0 = read, write = 1. most significant bit is req legntth, 0 = 8 bits, 1 = 16 bits
    input   wire       resp_done, //when cpu gets the output, this is pulled high. if pulled high, everything gets wiped

    output  reg        req_rdy,
    output  reg        out_rdy, //see if sram_out is valid. 1 for true, 0 for false. if 1, cpu will take that value. if it is a write, then 1 = write successful, 0 = failed
    output  reg [15:0] sram_out //change this name later, confusing with dout
);
//MEMORY CONTROL HAVE NO SAFEGUARDS, ITS ALL UP TO THE PROGRAMMER
//THIS IS BASED ON LINE 57-96 IN project.v in the MAIN branch
gf180mcu_ocd_ip_sram__sram256x8m8wm1 sram_inst (
  .CLK  (clk),  // clock
  .A    (sram_addr),  // address
  .D    (sram_din),  // put data from register a into sram
  .Q    (sram_dout),
  .CEN  (!(sram_str || sram_read)),  // sram en, active low
  .GWEN (!(sram_str)),  // sram write en, active low
  .WEN  (8'b00000000)  // might change this, allows rewriting of all bits
);
//req_type
localparam [1:0] READ_WORD  = 2'b00,
                 WRITE_WORD = 2'b01,
                 READ_BYTE  = 2'b10, //name is confusing, change later. but it just means it is reading sram for only one cell and is meant to be put in reg_file. basically opcode is load
                 WRITE_BYTE = 2'b11; //basically used for when opcode is store


//states
localparam [1:0] READ_WAIT    = 2'b00,
                 READ_CAPTURE = 2'b01,
                 WRITE        = 2'b10,
                 IDLE         = 2'b11;

                 
//REGISTERS
reg [7:0] req_addr_reg;
reg [1:0] req_type_reg;
reg [15:0] req_wdata_reg;

// MISC
reg [1:0] state, next_state;
//basic functions ig
reg [7:0] sram_addr;
reg sram_str;
reg sram_read;
reg [7:0] sram_din; //for writing

//READ INSTRUCTIONS

reg [15:0] instruction_output; //ONLY USED IF REQ_TYPE IS 1

// for if req_type[1] is 1. otherwise just output directly

reg     byte_sel, // 1 = high byte, 0 = low byte
        byte_sel_d;//used for prefetching, same logic as before in project.v in main 
    
initial begin
    byte_sel = 0;
    byte_sel_d = 0;
end

reg [7:0] low_byte;
reg [7:0] high_byte;

// for if req_type[1] is 0
wire [7:0] sram_dout;  

// WRITE INSTRUCTIONS




always @(*) begin
    if ((req_valid == 1'b1) && (req_rdy == 1'b1)) begin

       case (req_type) //since this is combinational, it cannot go in a register
           READ_WORD: begin
                next_state = READ_WAIT;
                sram_read = 1'b1;
            end
           WRITE_WORD: begin
                next_state = WRITE;
            
           end
           READ_BYTE: begin
                sram_read = 1'b1;
                sram_addr = req_addr; //can be done combinationally since req_addr doesn't change
                next_state = READ_WAIT;
            end
            WRITE_BYTE: begin
                sram_str = 1'b1;
                sram_addr = req_addr; // same here
                sram_din = req_wdata[7:0]; 
                next_state = WRITE;
           end
       endcase
    end
    else begin
        next_state = IDLE;
    end
    if (out_rdy == 1) begin
        sram_out = instruction_output;
        out_rdy = 0;
        next_state = IDLE;
    end
end

always @(posedge clk) begin
    if (!rst_n) begin
        byte_sel <= 1'b0;
    end
    else begin
        state <= next_state;
        case (state)
            READ_WAIT: begin
                if (req_type_reg == READ_WORD) begin
                    byte_sel_d <= byte_sel; //save if the current output is supposed to be a low or high byte
                    req_addr_reg <= req_addr_reg + 1'd1; //change address ahead of time
                    next_state <= READ_CAPTURE;
                end
                else begin
                    next_state <= READ_CAPTURE;
                end
            end
            READ_CAPTURE: begin
                case (req_type_reg)
                    READ_BYTE: begin //since it is just one byte, just go do it directly.
                        sram_out <= sram_dout; //get the data from sram and put it to the output
                        out_rdy <= 1;
                    end
                    READ_WORD: begin
                        case (byte_sel_d)
                            1'b0:begin
                                  low_byte <= sram_dout;
                                  byte_sel_d <= 1'b1;
                                  req_addr_reg <= req_addr_reg + 8'd1; //increment by 1 to write a word. least significant bit, 0 = low byte, 1 = high byte
                            end
                            1'b1: begin
                                  high_byte <= sram_dout;
                                  byte_sel_d <= 1'b0;
                                  out_rdy <= 1;
                            end
                        endcase  
                    end
                endcase
            end
            WRITE: begin
                case (req_type_reg)
                    WRITE_BYTE: begin
                        sram_out <= 8'b01110010;
                    end
                    WRITE_WORD: begin
                        case (byte_sel)
                            1'b0: begin
                                byte_sel  <= 1'b1;
                                sram_addr <= req_addr_reg;
                                sram_din  <= req_wdata_reg[7:0];
                            end 
                            1'b1: begin
                                byte_sel  <= 1'b0;
                                sram_addr <= req_addr + 8'd1;
                                sram_din  <= req_wdata_reg[15:8];
                            end
                    endcase
                end
                endcase
            end
            IDLE: begin
                if (req_valid && req_rdy) begin
                req_addr_reg <= req_addr;
                req_type_reg <= req_type;
                req_wdata_reg <= req_wdata; // UPDATED ON THE SAME EDGE OF WHEN SRAM ACCEPTS A REQUEST, SO IT WORKS
                end
                else
                req_rdy <= 1; //prolly inefficient
            end

        endcase
    end
end




    





